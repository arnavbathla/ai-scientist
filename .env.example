# --- Database ---
DATABASE_URL=postgresql://researchos:researchos@localhost:55432/researchos?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:56379

# --- NextAuth ---
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Scientific sources ---
# NCBI (PubMed). Email is required by the API; api key is optional but raises rate limits.
NCBI_EMAIL=research@example.com
NCBI_API_KEY=

# OpenAlex (polite pool). Email is strongly recommended.
OPENALEX_EMAIL=research@example.com

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- Optional: Worker tuning ---
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_HEARTBEAT_INTERVAL_MS=15000
RESEARCH_STALE_SESSION_AGE_MS=120000
